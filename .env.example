BOOKDROP_DATABASE_URL=sqlite:///./data/bookdrop.db

BOOKDROP_DISCORD_WEBHOOK_URL=

BOOKDROP_SMTP_HOST=
BOOKDROP_SMTP_PORT=587
BOOKDROP_SMTP_USERNAME=
BOOKDROP_SMTP_PASSWORD=
BOOKDROP_SMTP_USE_TLS=true
BOOKDROP_SMTP_FROM_ADDRESS=

BOOKDROP_AUDIOBOOKSHELF_URL=
BOOKDROP_AUDIOBOOKSHELF_API_TOKEN=

BOOKDROP_GOOGLE_BOOKS_API_KEY=
BOOKDROP_AUDIBLE_MARKETPLACE=us

BOOKDROP_RELEASE_CHECK_INTERVAL_MINUTES=60
BOOKDROP_DAILY_DIGEST_HOUR_UTC=13

# Integration API (/api/v1) for other services (e.g. a homepage dashboard).
# Leave the token blank to keep the API open; set it to require
# `Authorization: Bearer <token>` or an `X-API-Key` header.
BOOKDROP_INTEGRATION_API_TOKEN=
# Comma-separated allowed CORS origins, or * for any.
BOOKDROP_CORS_ALLOW_ORIGINS=*
